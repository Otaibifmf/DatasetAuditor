# DataChecker — single-box reverse proxy.
#
# bootstrap.sh substitutes {$DOMAIN} and writes this to /etc/caddy/Caddyfile.
# Caddy is the ONLY process bound to a public interface; the compose stack binds
# db/backend/frontend to 127.0.0.1 (see .env generated by bootstrap.sh).
#
# Everything goes to the frontend container, whose nginx serves the SPA and
# proxies /api/ to the backend. One upstream, no path splitting here — the
# frontend and backend agree on same-origin /api, so the browser never makes a
# cross-origin request and CORS never enters the picture.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy localhost:3000 {
		# A synchronous audit fans out into several upstream portal requests plus
		# a resource download. The frontend allows it 120s; give the proxy more
		# headroom than that so Caddy is never the thing that gives up first.
		transport http {
			read_timeout 180s
		}
	}

	log {
		output file /var/log/caddy/datachecker.log
		format console
	}
}

# ── Not configured here: rate limiting ───────────────────────────────────────
# /api/audit/* is unauthenticated and each call triggers outbound portal
# requests plus a file download, so a public deployment wants a limit on it.
# Caddy's rate_limit is a third-party module and is NOT in the standard apt
# build — adding a `rate_limit` directive to this file with the stock binary
# makes Caddy fail to start. Two real options:
#
#   1. xcaddy build --with github.com/mholt/caddy-ratelimit, then add:
#        rate_limit {
#            zone audit { key {remote_host} events 10 window 1m }
#        }
#   2. slowapi in FastAPI (backend-side, no custom Caddy build).
#
# Option 2 is less infrastructure. Neither is in place yet — the bulk/seed
# fan-out endpoints are gated off (ENABLE_BULK_ENDPOINTS=false), which caps the
# damage but does not cap request volume on the single-dataset audit route.

# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit it. Every value here is optional; anything
# left unset falls back to the defaults in docker-compose.yml / backend/config.py.

# ── Database ─────────────────────────────────────────────────────────────────
# Set a strong password before running on any shared or public machine.
# Generate one with:  openssl rand -hex 24
# Note: Postgres only reads this when the volume is first created. To change it
# later, run `docker compose down -v` (deletes data) or ALTER USER in psql.
POSTGRES_USER=datachecker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datachecker

# Leave unset under docker compose — it's built from the POSTGRES_* values above.
# Set it only when running the backend outside compose or against a hosted DB.
# DATABASE_URL=postgresql+asyncpg://datachecker:change-me@localhost:5432/datachecker

# ── Upstream data portal ─────────────────────────────────────────────────────
# Keep the default when this host has a Saudi IP. Outside KSA, point it at your
# relay (see relay/README.md) and set RELAY_KEY to the same value as the relay's.
PORTAL_BASE_URL=https://open.data.gov.sa
RELAY_KEY=

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. https://auditor.example.com
CORS_ORIGINS=*
HTTP_TIMEOUT=30

# ── Feature gates ────────────────────────────────────────────────────────────
ENABLE_BULK_ENDPOINTS=false

# ── Host ports (published ports on this machine) ─────────────────────────────
# DB_PORT is bound to 127.0.0.1 only.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
